pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                echo 'Cloning repository...'
            }
        }

        stage('Build') {
            steps {
                echo 'Installing dependencies (simulated)...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests (simulated)...'
            }
        }

        stage('Result') {
            steps {
                echo 'SUCCESS CI PIPELINE'
            }
        }
    }
}